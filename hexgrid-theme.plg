<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "hexgrid-theme">
<!ENTITY version "2026.11.01.0809">
<!ENTITY emhttp "/usr/local/emhttp/plugins/&name;">
<!ENTITY gitURL "https://raw.githubusercontent.com/Aestylis/unraid-starfield/main">
<!ENTITY pluginURL "&gitURL;/&name;.plg">
]>
<PLUGIN name="&name;" author="Aestylis" version="&version;" min="7.3.0" icon="th" pluginURL="&pluginURL;" support="https://github.com/Aestylis/unraid-starfield/issues">
<CHANGES>
###&version;
- Ember theme (orange/grey/black, Orbitron/Exo 2) with an animated hex grid background
</CHANGES>
<FILE Run="/bin/bash">
<INLINE>
for t in starfield-theme parity-theme; do
  if [ -d /usr/local/emhttp/plugins/$t ]; then
    echo "The $t theme plugin is installed. Remove it first: only one of starfield-theme, hexgrid-theme, parity-theme can be active."
    exit 1
  fi
done
</INLINE>
</FILE>
