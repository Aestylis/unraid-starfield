<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "starfield">
<!ENTITY version "2026.10.31.2315">
<!ENTITY emhttp "/usr/local/emhttp/plugins/&name;">
]>
<PLUGIN name="&name;" author="quentin" version="&version;" min="7.0.0" icon="star">
<CHANGES>
###&version;
- Nebula theme (Starfinder tracker palette, Orbitron/Exo 2) with a page-wide animated starfield
</CHANGES>
<FILE Name="&emhttp;/StarfieldHeader.page">
<INLINE>
<![CDATA[
Menu="Buttons:199"
Link="nav-starfield"
---
<link type="text/css" rel="stylesheet" href="<?autov('/plugins/starfield/nebula.css')?>">
<script src="<?autov('/plugins/starfield/starfield.js')?>"></script>
]]>
</INLINE>
</FILE>
<FILE Name="&emhttp;/nebula.css">
<INLINE>
<![CDATA[
/* Nebula theme for the Unraid webGui, from starfinder_campaign_tracker/src/theme/tokens.css (nebula preset).
 * Unraid themes are CSS variables on :root; `html:root` outranks them, and this file loads in <head> after the theme,
 * so there is no flash of the old colours. Surfaces are translucent so the page-wide starfield shows through. */
@font-face { font-family: 'Orbitron'; font-weight: 500; font-display: swap; src: url('fonts/orbitron-latin-500-normal.woff2') format('woff2'); }
@font-face { font-family: 'Orbitron'; font-weight: 700; font-display: swap; src: url('fonts/orbitron-latin-700-normal.woff2') format('woff2'); }
@font-face { font-family: 'Exo 2'; font-weight: 400; font-display: swap; src: url('fonts/exo-2-latin-400-normal.woff2') format('woff2'); }
@font-face { font-family: 'Exo 2'; font-weight: 600; font-display: swap; src: url('fonts/exo-2-latin-600-normal.woff2') format('woff2'); }

html:root {
  /* nebula tokens */
  --nb-bg: #07051a;
  --nb-bg-elev: #120c2c;
  --nb-panel: rgba(30, 18, 64, 0.62);
  --nb-panel-solid: rgba(22, 14, 50, 0.92);
  --nb-panel-border: rgba(180, 140, 255, 0.45);
  --nb-hairline: rgba(180, 140, 255, 0.38);
  --nb-accent: #b48cff;
  --nb-accent-deep: #7a4dff;
  --nb-accent-glow: rgba(180, 140, 255, 0.55);
  --nb-text: #ece6ff;
  --nb-text-dim: #a99fc8;
  --nb-link: #7fd8ff;
  --nb-font-display: 'Orbitron', sans-serif;
  --nb-font-body: 'Exo 2', sans-serif;
  --nb-chamfer: 10px;
  --nb-text-glow: 0 0 12px var(--nb-accent-glow);

  /* Unraid theme variables -> nebula */
  --text-color: var(--nb-text);
  --blockquote-text-color: var(--nb-text);
  --alt-text-color: var(--nb-text-dim);
  --disabled-text-color: #6f6690;
  --link-text-color: var(--nb-link);

  --background-color: var(--nb-bg);
  --opac-background-color: rgba(7, 5, 26, 0.88);
  --mild-background-color: var(--nb-panel);
  --usage-bar-background-color: rgba(180, 140, 255, 0.14);
  --usage-bar-used-background-color: var(--nb-accent);
  --usage-disk-background-color: rgba(180, 140, 255, 0.14);
  --radio-background-color: rgba(180, 140, 255, 0.2);
  --dashboard-background-color: var(--nb-panel);
  --dashboard-icon-color: var(--nb-accent);

  --border-color: var(--nb-panel-border);
  --input-border-color: rgba(180, 140, 255, 0.6);
  --textarea-border-color: var(--nb-hairline);
  --inverse-border-color: var(--nb-hairline);
  --table-border-color: var(--nb-hairline);
  --table-background-color: rgba(18, 12, 44, 0.55);
  --table-header-background-color: var(--nb-panel);
  --hover-table-row-background-color: rgba(180, 140, 255, 0.09);

  --footer-text: var(--nb-text-dim);
  --footer-background-color: rgba(7, 5, 26, 0.82);
  --small-shadow: 0 0 6px var(--nb-accent-glow);
  --hr-color: var(--nb-hairline);
  --checkbox-color: var(--nb-accent);
  --checkbox-hover-color: #c9a6ff;

  --brand-orange: var(--nb-accent);
  --brand-red: var(--nb-accent-deep);

  --header-text-color: var(--nb-text);
  --header-background-color: transparent;
  --custom-header-background-color: transparent;
  --banner-gradient: none;
  --title-header-background-color: var(--nb-panel);

  --scrollbar-color: rgba(180, 140, 255, 0.45);
  --scrollbar-hover-color: var(--nb-accent);

  --button-text-color: var(--nb-text);
  --hover-button-border: var(--nb-accent);
  --hover-button-text-color: #fff;

  --focus-input-bg-color: rgba(30, 18, 64, 0.85);
  --shade-bg-color: rgba(18, 12, 44, 0.7);
  --dynamix-filetree-bg-color: var(--nb-bg-elev);

  /* tablesorter (Plugins, Docker, Unassigned Devices tables) */
  --dynamix-tablesorter-thead-row-border-color: var(--nb-hairline);
  --dynamix-tablesorter-thead-th-text-color: var(--nb-text);
  --dynamix-tablesorter-thead-th-bg-color: var(--nb-panel);
  --dynamix-tablesorter-tbody-row-alt-bg-color: rgba(18, 12, 44, 0.55);
  --dynamix-tablesorter-tbody-row-bg-color: transparent;
  --dynamix-tablesorter-tbody-row-border-color: var(--nb-hairline);
  --dynamix-select-box-shadow: 0 2px 0 var(--nb-accent), inset 0 -1px var(--nb-bg);
  --dynamix-select-disabled-bg-color: rgba(18, 12, 44, 0.7);
  --dynamix-tooltipster-sidetip-bg-from: var(--nb-bg-elev);
  --dynamix-tooltipster-sidetip-bg-to: #1d1240;
  --dynamix-tooltipster-sidetip-arrow-bg-color: #1d1240;
  --dynamix-tooltipster-sidetip-box-border-color: var(--nb-accent);
  --dynamix-awesomplete-text-color: var(--nb-text);
  --dynamix-awesomplete-list-bg-color: var(--nb-panel-solid);
  --dynamix-awesomplete-list-bg-from-color: var(--nb-panel-solid);
  --dynamix-awesomplete-list-before-bg-color: var(--nb-panel-solid);
  --dynamix-awesomplete-list-item-hover-bg-color: rgba(180, 140, 255, 0.25);
  --dynamix-awesomplete-list-item-hover-text-color: var(--nb-text);
  --dynamix-awesomplete-list-item-selected-bg-color: var(--nb-accent-deep);
  --dynamix-awesomplete-mark-hover-bg-color: var(--nb-accent);

  /* Community Apps */
  --template-background: var(--nb-panel);
  --template-hover-background: rgba(48, 30, 96, 0.75);
  --template-favourite: rgba(180, 140, 255, 0.22);
  --a-color: var(--nb-link);
  --sidebar-background: rgba(7, 5, 26, 0.8);
  --sidebar-text: var(--nb-text);
  --support-popup-text: var(--nb-text);
  --support-popup-background: var(--nb-panel-solid);
  --unraid-66-color: var(--nb-accent);
  --ca-legacy-background-color: transparent;
  --tooltipster-content: var(--nb-text);
  --chart-grid: var(--nb-hairline);
}

/* Unraid declares these on `.Theme--black:root` (specificity 0,2,0); `html:root:root` (0,2,1) beats it. */
html:root:root {
  --dynamix-jquery-ui-button-text-color: var(--nb-text);
  --dynamix-jquery-ui-button-background-start: var(--nb-accent-deep);
  --dynamix-jquery-ui-button-background-end: var(--nb-accent);
  --dynamix-jquery-ui-button-hover-color: #fff;
  --dynamix-jquery-ui-border-color: var(--nb-panel-border);
  --dynamix-jquery-ui-header-background: var(--nb-panel);
  --dynamix-jquery-ui-header-color: var(--nb-text);
  --dynamix-jquery-ui-content-background: var(--nb-panel-solid);
  --dynamix-jquery-ui-content-color: var(--nb-text);
  --dynamix-jquery-ui-active-background: rgba(180, 140, 255, 0.2);
  --dynamix-jquery-ui-dropcontainer-background: var(--nb-panel-solid);
  --dynamix-jquery-ui-disabled-background: rgba(18, 12, 44, 0.7);
  --dynamix-jquery-ui-text-color: var(--nb-text);
}

/* page: deep purple with Nebula's glow; the starfield canvas sits behind everything */
html:root body {
  background-color: var(--nb-bg);
  background-image: radial-gradient(ellipse at 15% -10%, #2a1556 0%, #0c0824 45%, transparent 75%);
  background-attachment: fixed;
  font-family: var(--nb-font-body);
}
html:root body input,
html:root body select,
html:root body textarea,
html:root body button {
  font-family: var(--nb-font-body);
}
.starfield-canvas {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
  pointer-events: none;
}

/* header: banner image off, stars show through */
#header {
  background-image: none !important;
  background-color: transparent !important;
  color: var(--nb-text);
}
.nav-starfield { display: none !important; }

/* nav bar: glass strip with a hairline, Orbitron labels */
.nav-tile {
  background-color: rgba(12, 8, 36, 0.72) !important;
  backdrop-filter: blur(6px);
  border-top: 1px solid var(--nb-hairline);
  border-bottom: 1px solid var(--nb-hairline);
  font-family: var(--nb-font-display);
  font-size: 1.1rem;
}
.nav-tile .nav-item a { color: var(--nb-text-dim); }
.nav-tile .nav-item a:hover,
.nav-tile .nav-item.active a {
  color: var(--nb-text);
  text-shadow: var(--nb-text-glow);
}
.nav-tile .nav-item.active a { box-shadow: inset 0 -2px 0 var(--nb-accent); }

/* section title bars: chamfered holo panels with a glowing Orbitron label */
div.title {
  background-color: var(--nb-panel);
  backdrop-filter: blur(6px);
  border-bottom: none;
  clip-path: polygon(0 0, calc(100% - var(--nb-chamfer)) 0, 100% var(--nb-chamfer), 100% 100%, var(--nb-chamfer) 100%, 0 calc(100% - var(--nb-chamfer)));
  outline: 1px solid var(--nb-panel-border);
  outline-offset: -1px;
  font-family: var(--nb-font-display);
  font-size: 1.25rem;
  letter-spacing: 0.08em;
  color: var(--nb-text);
  text-shadow: var(--nb-text-glow);
}

/* tables and panels: translucent so the stars come through */
table thead tr,
table.disk_status thead tr,
table.share_status thead tr {
  background-color: var(--nb-panel) !important;
  font-family: var(--nb-font-display);
  letter-spacing: 0.05em;
}

/* buttons: violet frame, glow on hover */
input[type="button"],
input[type="reset"],
input[type="submit"],
button:not([role="tab"]),
a.button {
  font-family: var(--nb-font-display) !important;
  letter-spacing: 0.06em;
}
input[type="button"]:hover,
input[type="reset"]:hover,
input[type="submit"]:hover,
button:not([role="tab"]):hover,
a.button:hover {
  box-shadow: 0 0 12px var(--nb-accent-glow);
}

/* inputs */
input[type="text"],
input[type="password"],
input[type="number"],
input[type="email"],
select,
textarea {
  color: var(--nb-text);
}
input:focus,
select:focus,
textarea:focus {
  box-shadow: 0 0 8px var(--nb-accent-glow);
}

/* tabs */
.tabs button[role="tab"][aria-selected="true"] {
  border-color: var(--nb-accent);
  text-shadow: var(--nb-text-glow);
}
.tabs button[role="tab"] { font-family: var(--nb-font-display); }

/* toggle switches (jquery.switchbutton hardcodes blue/grey) */
.switch-button-label.on { color: var(--nb-accent) !important; }
.switch-button-label { color: var(--nb-text-dim); }
.switch-button-background {
  background-color: rgba(180, 140, 255, 0.12) !important;
  border-color: var(--nb-hairline) !important;
}
.switch-button-background.checked {
  background-color: var(--nb-accent-deep) !important;
  box-shadow: 0 0 8px var(--nb-accent-glow);
}
.switch-button-button {
  background-color: var(--nb-text) !important;
  border-color: var(--nb-panel-border) !important;
}

/* Community Apps: cards as holo panels, search box glass */
.ca_holder, .ca_template, div.ca_holderDocker, div.ca_holderPlugin {
  backdrop-filter: blur(6px);
  border-color: var(--nb-panel-border) !important;
}
.searchArea input, input#searchBox, input.searchBox {
  background-color: var(--nb-panel) !important;
  color: var(--nb-text) !important;
  border: 1px solid var(--nb-hairline) !important;
}
img.ca_displayIcon, img.popupIcon { background-color: rgba(180, 140, 255, 0.14); }

/* catch-all for tables whose header/stripe colours are hardcoded (Main boot table, Unassigned Devices, ...) */
#displaybox table:not(.dashboard) thead tr:first-child > td,
#displaybox table:not(.dashboard) thead tr > th {
  background-color: var(--nb-panel) !important;
}
#displaybox table:not(.dashboard) tbody tr:nth-child(even) {
  background-color: rgba(18, 12, 44, 0.55) !important;
}
#displaybox table:not(.dashboard) tbody tr:nth-child(odd) {
  background-color: transparent;
}

/* header logo: shift Unraid's red-orange gradient into Nebula violet (it lives in a web component) */
#header unraid-header-os-version {
  filter: hue-rotate(250deg) saturate(1.15) drop-shadow(0 0 6px rgba(180, 140, 255, 0.45));
}

/* Stats charts (Highcharts 2 SVG: colours are presentation attributes, which CSS properties override) */
svg stop[stop-color="rgb(96,96,96)"] { stop-color: rgb(46, 28, 96); }
svg stop[stop-color="rgb(16,16,16)"] { stop-color: rgb(9, 6, 28); }
svg [fill="#E68A00" i] { fill: #b48cff; }
svg [stroke="#E68A00" i] { stroke: #b48cff; }
svg [fill="#EDC240" i] { fill: #7fd8ff; }
svg [stroke="#EDC240" i] { stroke: #7fd8ff; }
svg [fill="#BDE5F8" i] { fill: #ff3df2; }
svg [stroke="#BDE5F8" i] { stroke: #ff3df2; }
svg [fill="#4DA74D" i] { fill: #5cff8a; }
svg [stroke="#4DA74D" i] { stroke: #5cff8a; }
svg [stroke="#C0C0C0" i] { stroke: rgba(180, 140, 255, 0.22); }
svg text { font-family: var(--nb-font-body) !important; }

/* footer: glass strip */
#footer {
  backdrop-filter: blur(6px);
  border-top: 1px solid var(--nb-hairline);
}

/* popups/dialogs stay solid so text over them is readable */
.sweet-alert,
.ui-dialog,
.ui-dialog .ui-dialog-content {
  background-color: var(--nb-panel-solid) !important;
  color: var(--nb-text) !important;
  border: 1px solid var(--nb-panel-border);
}

@media (prefers-reduced-transparency: reduce) {
  html:root { --nb-panel: var(--nb-panel-solid); }
}
]]>
</INLINE>
</FILE>
<FILE Name="&emhttp;/starfield.js">
<INLINE>
<![CDATA[
/* Unraid page starfield (Nebula theme).
 * Ported from starfinder_campaign_tracker/src/fx/starfield.ts: three parallax layers drift slowly left (redrawn at
 * ~24 fps), a few stars twinkle, and the cursor pushes nearby stars away (they spring back). Fixed behind the whole
 * page; the Nebula CSS makes surfaces translucent. requestAnimationFrame pauses it in hidden tabs; prefers-reduced-motion draws one still frame.
 */
(function () {
  'use strict'

  var STAR_LAYERS = [
    { perMp: 160, size: 0.55, alpha: 0.55, speed: 4 }, // far: dim, slow
    { perMp: 300, size: 0.8, alpha: 0.8, speed: 8 },
    { perMp: 120, size: 1.15, alpha: 1.0, speed: 14 }, // near: sparse, bright, fastest
  ]
  var DENSITY = 1
  var ACCENT_RGB = '180,140,255' // Nebula violet, used by ~8% of stars
  var FRAME_MS = 1000 / 24
  var LAYER_DEPTH = [0.45, 0.75, 1]
  var PUSH_RADIUS = 170
  var PUSH_MAX = 40
  var SPRING = 0.12
  var DAMPING = 0.78
  var SETTLED = 0.05

  function tint(alpha) {
    var t = Math.random()
    if (t < 0.12) return 'rgba(185,205,255,' + alpha + ')'
    if (t < 0.2) return 'rgba(' + ACCENT_RGB + ',' + alpha + ')'
    return 'rgba(255,255,255,' + alpha + ')'
  }

  function Starfield() {
    var self = this
    this.reducedMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)
    this.canvas = document.createElement('canvas')
    this.canvas.className = 'starfield-canvas'
    this.canvas.setAttribute('aria-hidden', 'true')
    document.body.insertBefore(this.canvas, document.body.firstChild)
    this.ctx = this.canvas.getContext('2d')
    if (!this.ctx) return
    this.stars = []
    this.twinkle = []
    this.offsets = [0, 0, 0]
    this.w = this.h = 0
    this.dpr = 1
    this.acc = 0
    this.mx = this.my = -1e6
    this.resize()
    var timer
    window.addEventListener('resize', function () {
      clearTimeout(timer)
      timer = setTimeout(function () { self.resize() }, 150)
    })
    if (this.reducedMotion) return
    window.addEventListener('pointermove', function (e) {
      self.mx = e.clientX
      self.my = e.clientY
    })
    var leave = function () { self.mx = self.my = -1e6 }
    document.addEventListener('mouseleave', leave)
    window.addEventListener('blur', leave)
    window.addEventListener('pointerup', function (e) { if (e.pointerType !== 'mouse') leave() })
    this.last = performance.now()
    requestAnimationFrame(function loop(t) { self.tick(t); requestAnimationFrame(loop) })
  }

  Starfield.prototype.resize = function () {
    var w = Math.max(1, window.innerWidth)
    var h = Math.max(1, window.innerHeight)
    if (w === this.w && h === this.h && this.stars.length) return
    this.w = w
    this.h = h
    this.dpr = Math.min(window.devicePixelRatio || 1, 2)
    this.canvas.width = Math.round(w * this.dpr)
    this.canvas.height = Math.round(h * this.dpr)
    var mp = ((w * h) / 1e6) * DENSITY
    var stars = []
    STAR_LAYERS.forEach(function (sp, layer) {
      var n = Math.round(sp.perMp * mp)
      for (var i = 0; i < n; i++)
        stars.push({ x: Math.random() * w, y: Math.random() * h, r: sp.size * (0.7 + Math.random() * 0.6), tint: tint(sp.alpha), layer: layer, ox: 0, oy: 0, vx: 0, vy: 0 })
    })
    this.stars = stars
    this.offsets = STAR_LAYERS.map(function () { return Math.random() * w })
    this.twinkle = []
    for (var j = 0, n2 = Math.max(4, Math.round(14 * mp)); j < n2; j++)
      this.twinkle.push({ x: Math.random() * w, y: Math.random() * h, r: 0.6 + Math.random() * 0.4, phase: Math.random() * Math.PI * 2, speed: 1.2 + Math.random() * 1.6, tint: tint(1) })
    this.draw(performance.now())
  }

  Starfield.prototype.homeX = function (s) {
    return (((s.x - this.offsets[s.layer]) % this.w) + this.w) % this.w
  }

  Starfield.prototype.push = function () {
    var moving = false
    for (var i = 0; i < this.stars.length; i++) {
      var s = this.stars[i]
      var dx = this.homeX(s) - this.mx
      var dy = s.y - this.my
      var d = Math.hypot(dx, dy)
      var tx = 0, ty = 0
      if (d < PUSH_RADIUS && d > 0.5) {
        var f = Math.pow(1 - d / PUSH_RADIUS, 2) * PUSH_MAX * LAYER_DEPTH[s.layer]
        tx = (dx / d) * f
        ty = (dy / d) * f
      }
      s.vx = (s.vx + (tx - s.ox) * SPRING) * DAMPING
      s.vy = (s.vy + (ty - s.oy) * SPRING) * DAMPING
      s.ox += s.vx
      s.oy += s.vy
      if (Math.abs(s.vx) > SETTLED || Math.abs(s.vy) > SETTLED || Math.abs(s.ox - tx) > SETTLED || Math.abs(s.oy - ty) > SETTLED) moving = true
    }
    return moving
  }

  Starfield.prototype.tick = function (t) {
    var dt = Math.min(100, t - this.last)
    this.last = t
    this.acc += dt
    var cursorIn = this.mx > -1e5
    var displaced = false
    for (var i = 0; i < this.stars.length && !displaced; i++) displaced = this.stars[i].ox !== 0 || this.stars[i].oy !== 0
    if (!(cursorIn || displaced || this.acc >= FRAME_MS)) return
    var step = this.acc / 1000
    this.acc = 0
    for (var l = 0; l < STAR_LAYERS.length; l++) this.offsets[l] = (this.offsets[l] + STAR_LAYERS[l].speed * step) % this.w
    var moving = this.push()
    if (!moving && !cursorIn) this.stars.forEach(function (s) { s.ox = s.oy = s.vx = s.vy = 0 })
    this.draw(t)
  }

  Starfield.prototype.draw = function (t) {
    var ctx = this.ctx
    if (!ctx) return
    ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0)
    ctx.clearRect(0, 0, this.w, this.h)
    for (var i = 0; i < this.stars.length; i++) {
      var s = this.stars[i]
      ctx.fillStyle = s.tint
      ctx.beginPath()
      ctx.arc(this.homeX(s) + s.ox, s.y + s.oy, s.r * (1 + Math.min(1, Math.hypot(s.ox, s.oy) / PUSH_MAX) * 0.6), 0, Math.PI * 2)
      ctx.fill()
    }
    for (var j = 0; j < this.twinkle.length; j++) {
      var tw = this.twinkle[j]
      ctx.globalAlpha = this.reducedMotion ? 0.7 : 0.25 + 0.75 * (0.5 + 0.5 * Math.sin((t / 1000) * tw.speed + tw.phase))
      ctx.fillStyle = tw.tint
      ctx.beginPath()
      ctx.arc(tw.x, tw.y, tw.r, 0, Math.PI * 2)
      ctx.fill()
    }
    ctx.globalAlpha = 1
  }

  function start() {
    if (!document.body || document.querySelector('.starfield-canvas')) return
    new Starfield()
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start)
  else start()
})()
]]>
</INLINE>
</FILE>
<FILE Run="/bin/bash">
<INLINE>
mkdir -p /usr/local/emhttp/plugins/starfield/fonts
cp /boot/config/plugins/starfield/fonts/*.woff2 /usr/local/emhttp/plugins/starfield/fonts/ 2>/dev/null
chmod -R a+rX /usr/local/emhttp/plugins/starfield
rm -f /usr/local/emhttp/plugins/starfield/starfield.css
echo "starfield: $(ls /usr/local/emhttp/plugins/starfield/fonts | wc -l) fonts installed"
</INLINE>
</FILE>
<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -rf /usr/local/emhttp/plugins/starfield /boot/config/plugins/starfield
echo "starfield removed"
</INLINE>
</FILE>
</PLUGIN>
