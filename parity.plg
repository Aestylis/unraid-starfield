<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "parity">
<!ENTITY version "2026.10.31.2327">
<!ENTITY emhttp "/usr/local/emhttp/plugins/&name;">
<!ENTITY gitURL "https://raw.githubusercontent.com/Aestylis/unraid-starfield/main">
<!ENTITY pluginURL "&gitURL;/&name;.plg">
]>
<PLUGIN name="&name;" author="Aestylis" version="&version;" min="7.3.0" icon="hdd-o" pluginURL="&pluginURL;" support="https://github.com/Aestylis/unraid-starfield/issues">
<CHANGES>
###&version;
- Array theme (Unraid brand red/orange, Unraid fonts) with a live disk-array background
</CHANGES>
<FILE Run="/bin/bash">
<INLINE>
for t in starfield hexgrid; do
  if [ -d /usr/local/emhttp/plugins/$t ]; then
    echo "The $t theme plugin is installed. Remove it first: only one of starfield/hexgrid/parity can be active."
    exit 1
  fi
done
</INLINE>
</FILE>
<FILE Name="&emhttp;/ParityHeader.page">
<INLINE>
<![CDATA[
Menu="Buttons:199"
Link="nav-starfield"
---
<link type="text/css" rel="stylesheet" href="<?autov('/plugins/parity/array.css')?>">
<script src="<?autov('/plugins/parity/parity.js')?>"></script>
]]>
</INLINE>
</FILE>
<FILE Name="&emhttp;/array.css">
<INLINE>
<![CDATA[
/* Array theme for the Unraid webGui: Unraid brand red (#e22828) -> orange (#ff8c2f) on charcoal, Unraid's own fonts,
 * generated from nebula.css by make-themes.py.
 * Unraid themes are CSS variables on :root; `html:root` outranks them, and this file loads in <head> after the theme,
 * so there is no flash of the old colours. Surfaces are translucent so the page-wide disk array shows through. */

html:root {
  /* nebula tokens */
  --nb-bg: #0b0b0c;
  --nb-bg-elev: #151517;
  --nb-panel: rgba(24, 24, 26, 0.62);
  --nb-panel-solid: rgba(20, 20, 22, 0.92);
  --nb-panel-border: rgba(255, 140, 47, 0.45);
  --nb-hairline: rgba(255, 140, 47, 0.38);
  --nb-accent: #ff8c2f;
  --nb-accent-deep: #e22828;
  --nb-accent-glow: rgba(255, 140, 47, 0.55);
  --nb-text: #f2f2f2;
  --nb-text-dim: #9e9e9e;
  --nb-link: #ffa463;
  --nb-font-display: bitstream, monospace;
  --nb-font-body: clear-sans, sans-serif;
  --nb-chamfer: 10px;
  --nb-text-glow: 0 0 12px var(--nb-accent-glow);

  /* Unraid theme variables -> nebula */
  --text-color: var(--nb-text);
  --blockquote-text-color: var(--nb-text);
  --alt-text-color: var(--nb-text-dim);
  --disabled-text-color: #666666;
  --link-text-color: var(--nb-link);

  --background-color: var(--nb-bg);
  --opac-background-color: rgba(10, 10, 12, 0.88);
  --mild-background-color: var(--nb-panel);
  --usage-bar-background-color: rgba(255, 140, 47, 0.14);
  --usage-bar-used-background-color: var(--nb-accent);
  --usage-disk-background-color: rgba(255, 140, 47, 0.14);
  --radio-background-color: rgba(255, 140, 47, 0.2);
  --dashboard-background-color: var(--nb-panel);
  --dashboard-icon-color: var(--nb-accent);

  --border-color: var(--nb-panel-border);
  --input-border-color: rgba(255, 140, 47, 0.6);
  --textarea-border-color: var(--nb-hairline);
  --inverse-border-color: var(--nb-hairline);
  --table-border-color: var(--nb-hairline);
  --table-background-color: rgba(22, 22, 24, 0.55);
  --table-header-background-color: var(--nb-panel);
  --hover-table-row-background-color: rgba(255, 140, 47, 0.09);

  --footer-text: var(--nb-text-dim);
  --footer-background-color: rgba(10, 10, 12, 0.82);
  --small-shadow: 0 0 6px var(--nb-accent-glow);
  --hr-color: var(--nb-hairline);
  --checkbox-color: var(--nb-accent);
  --checkbox-hover-color: #ffad66;

  --brand-orange: var(--nb-accent);
  --brand-red: var(--nb-accent-deep);

  --header-text-color: var(--nb-text);
  --header-background-color: transparent;
  --custom-header-background-color: transparent;
  --banner-gradient: none;
  --title-header-background-color: var(--nb-panel);

  --scrollbar-color: rgba(255, 140, 47, 0.45);
  --scrollbar-hover-color: var(--nb-accent);

  --button-text-color: var(--nb-text);
  --hover-button-border: var(--nb-accent);
  --hover-button-text-color: #fff;

  --focus-input-bg-color: rgba(24, 24, 26, 0.85);
  --shade-bg-color: rgba(22, 22, 24, 0.7);
  --dynamix-filetree-bg-color: var(--nb-bg-elev);

  /* tablesorter (Plugins, Docker, Unassigned Devices tables) */
  --dynamix-tablesorter-thead-row-border-color: var(--nb-hairline);
  --dynamix-tablesorter-thead-th-text-color: var(--nb-text);
  --dynamix-tablesorter-thead-th-bg-color: var(--nb-panel);
  --dynamix-tablesorter-tbody-row-alt-bg-color: rgba(22, 22, 24, 0.55);
  --dynamix-tablesorter-tbody-row-bg-color: transparent;
  --dynamix-tablesorter-tbody-row-border-color: var(--nb-hairline);
  --dynamix-select-box-shadow: 0 2px 0 var(--nb-accent), inset 0 -1px var(--nb-bg);
  --dynamix-select-disabled-bg-color: rgba(22, 22, 24, 0.7);
  --dynamix-tooltipster-sidetip-bg-from: var(--nb-bg-elev);
  --dynamix-tooltipster-sidetip-bg-to: #202022;
  --dynamix-tooltipster-sidetip-arrow-bg-color: #202022;
  --dynamix-tooltipster-sidetip-box-border-color: var(--nb-accent);
  --dynamix-awesomplete-text-color: var(--nb-text);
  --dynamix-awesomplete-list-bg-color: var(--nb-panel-solid);
  --dynamix-awesomplete-list-bg-from-color: var(--nb-panel-solid);
  --dynamix-awesomplete-list-before-bg-color: var(--nb-panel-solid);
  --dynamix-awesomplete-list-item-hover-bg-color: rgba(255, 140, 47, 0.25);
  --dynamix-awesomplete-list-item-hover-text-color: var(--nb-text);
  --dynamix-awesomplete-list-item-selected-bg-color: var(--nb-accent-deep);
  --dynamix-awesomplete-mark-hover-bg-color: var(--nb-accent);

  /* Community Apps */
  --template-background: var(--nb-panel);
  --template-hover-background: rgba(52, 26, 22, 0.75);
  --template-favourite: rgba(255, 140, 47, 0.22);
  --a-color: var(--nb-link);
  --sidebar-background: rgba(10, 10, 12, 0.8);
  --sidebar-text: var(--nb-text);
  --support-popup-text: var(--nb-text);
  --support-popup-background: var(--nb-panel-solid);
  --unraid-66-color: var(--nb-accent);
  --ca-legacy-background-color: transparent;
  --tooltipster-content: var(--nb-text);
  --chart-grid: var(--nb-hairline);
}

/* Unraid declares these on `.Theme--black:root` (specificity 0,2,0); `html:root:root` (0,2,1) beats it. */
html:root:root {
  --dynamix-jquery-ui-button-text-color: var(--nb-text);
  --dynamix-jquery-ui-button-background-start: var(--nb-accent-deep);
  --dynamix-jquery-ui-button-background-end: var(--nb-accent);
  --dynamix-jquery-ui-button-hover-color: #fff;
  --dynamix-jquery-ui-border-color: var(--nb-panel-border);
  --dynamix-jquery-ui-header-background: var(--nb-panel);
  --dynamix-jquery-ui-header-color: var(--nb-text);
  --dynamix-jquery-ui-content-background: var(--nb-panel-solid);
  --dynamix-jquery-ui-content-color: var(--nb-text);
  --dynamix-jquery-ui-active-background: rgba(255, 140, 47, 0.2);
  --dynamix-jquery-ui-dropcontainer-background: var(--nb-panel-solid);
  --dynamix-jquery-ui-disabled-background: rgba(22, 22, 24, 0.7);
  --dynamix-jquery-ui-text-color: var(--nb-text);
}

/* page: charcoal with a faint red glow; the disk array canvas sits behind everything */
html:root body {
  background-color: var(--nb-bg);
  background-image: radial-gradient(ellipse at 15% -10%, #2a0e0e 0%, #0f0d0d 45%, transparent 75%);
  background-attachment: fixed;
  font-family: var(--nb-font-body);
}
html:root body input,
html:root body select,
html:root body textarea,
html:root body button {
  font-family: var(--nb-font-body);
}
.starfield-canvas {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
  pointer-events: none;
}

/* header: banner image off, stars show through */
#header {
  background-image: none !important;
  background-color: transparent !important;
  color: var(--nb-text);
}
.nav-starfield { display: none !important; }

/* nav bar: glass strip with a hairline, Orbitron labels */
.nav-tile {
  background-color: rgba(14, 14, 16, 0.72) !important;
  backdrop-filter: blur(6px);
  border-top: 1px solid var(--nb-hairline);
  border-bottom: 1px solid var(--nb-hairline);
  font-family: var(--nb-font-display);
  font-size: 1.1rem;
}
.nav-tile .nav-item a { color: var(--nb-text-dim); }
.nav-tile .nav-item a:hover,
.nav-tile .nav-item.active a {
  color: var(--nb-text);
  text-shadow: var(--nb-text-glow);
}
.nav-tile .nav-item.active a { box-shadow: inset 0 -2px 0 var(--nb-accent); }

/* section title bars: chamfered holo panels with a glowing Orbitron label */
div.title {
  background-color: var(--nb-panel);
  backdrop-filter: blur(6px);
  border-bottom: none;
  clip-path: polygon(0 0, calc(100% - var(--nb-chamfer)) 0, 100% var(--nb-chamfer), 100% 100%, var(--nb-chamfer) 100%, 0 calc(100% - var(--nb-chamfer)));
  outline: 1px solid var(--nb-panel-border);
  outline-offset: -1px;
  font-family: var(--nb-font-display);
  font-size: 1.25rem;
  letter-spacing: 0.08em;
  color: var(--nb-text);
  text-shadow: var(--nb-text-glow);
}

/* tables and panels: translucent so the stars come through */
table thead tr,
table.disk_status thead tr,
table.share_status thead tr {
  background-color: var(--nb-panel) !important;
  font-family: var(--nb-font-display);
  letter-spacing: 0.05em;
}

/* buttons: violet frame, glow on hover */
input[type="button"],
input[type="reset"],
input[type="submit"],
button:not([role="tab"]),
a.button {
  font-family: var(--nb-font-display) !important;
  letter-spacing: 0.06em;
}
input[type="button"]:hover,
input[type="reset"]:hover,
input[type="submit"]:hover,
button:not([role="tab"]):hover,
a.button:hover {
  box-shadow: 0 0 12px var(--nb-accent-glow);
}

/* inputs */
input[type="text"],
input[type="password"],
input[type="number"],
input[type="email"],
select,
textarea {
  color: var(--nb-text);
}
input:focus,
select:focus,
textarea:focus {
  box-shadow: 0 0 8px var(--nb-accent-glow);
}

/* tabs */
.tabs button[role="tab"][aria-selected="true"] {
  border-color: var(--nb-accent);
  text-shadow: var(--nb-text-glow);
}
.tabs button[role="tab"] { font-family: var(--nb-font-display); }

/* toggle switches (jquery.switchbutton hardcodes blue/grey) */
.switch-button-label.on { color: var(--nb-accent) !important; }
.switch-button-label { color: var(--nb-text-dim); }
.switch-button-background {
  background-color: rgba(255, 140, 47, 0.12) !important;
  border-color: var(--nb-hairline) !important;
}
.switch-button-background.checked {
  background-color: var(--nb-accent-deep) !important;
  box-shadow: 0 0 8px var(--nb-accent-glow);
}
.switch-button-button {
  background-color: var(--nb-text) !important;
  border-color: var(--nb-panel-border) !important;
}

/* Community Apps: cards as holo panels, search box glass */
.ca_holder, .ca_template, div.ca_holderDocker, div.ca_holderPlugin {
  backdrop-filter: blur(6px);
  border-color: var(--nb-panel-border) !important;
}
.searchArea input, input#searchBox, input.searchBox {
  background-color: var(--nb-panel) !important;
  color: var(--nb-text) !important;
  border: 1px solid var(--nb-hairline) !important;
}
img.ca_displayIcon, img.popupIcon { background-color: rgba(255, 140, 47, 0.14); }

/* catch-all for tables whose header/stripe colours are hardcoded (Main boot table, Unassigned Devices, ...) */
#displaybox table:not(.dashboard) thead tr:first-child > td,
#displaybox table:not(.dashboard) thead tr > th {
  background-color: var(--nb-panel) !important;
}
#displaybox table:not(.dashboard) tbody tr:nth-child(even) {
  background-color: rgba(22, 22, 24, 0.55) !important;
}
#displaybox table:not(.dashboard) tbody tr:nth-child(odd) {
  background-color: transparent;
}

/* header logo: keep the Unraid logo as-is, with a red-orange glow (it lives in a web component) */
#header unraid-header-os-version {
  filter: drop-shadow(0 0 6px rgba(226, 40, 40, 0.5));
}

/* Stats charts (Highcharts 2 SVG: colours are presentation attributes, which CSS properties override) */
svg stop[stop-color="rgb(96,96,96)"] { stop-color: rgb(34, 34, 36); }
svg stop[stop-color="rgb(16,16,16)"] { stop-color: rgb(12, 12, 12); }
svg [fill="#E68A00" i] { fill: #ff8c2f; }
svg [stroke="#E68A00" i] { stroke: #ff8c2f; }
svg [fill="#EDC240" i] { fill: #e22828; }
svg [stroke="#EDC240" i] { stroke: #e22828; }
svg [fill="#BDE5F8" i] { fill: #f2f2f2; }
svg [stroke="#BDE5F8" i] { stroke: #f2f2f2; }
svg [fill="#4DA74D" i] { fill: #5cff8a; }
svg [stroke="#4DA74D" i] { stroke: #5cff8a; }
svg [stroke="#C0C0C0" i] { stroke: rgba(255, 140, 47, 0.22); }
svg text { font-family: var(--nb-font-body) !important; }

/* footer: glass strip */
#footer {
  backdrop-filter: blur(6px);
  border-top: 1px solid var(--nb-hairline);
}

/* popups/dialogs stay solid so text over them is readable */
.sweet-alert,
.ui-dialog,
.ui-dialog .ui-dialog-content {
  background-color: var(--nb-panel-solid) !important;
  color: var(--nb-text) !important;
  border: 1px solid var(--nb-panel-border);
}

@media (prefers-reduced-transparency: reduce) {
  html:root { --nb-panel: var(--nb-panel-solid); }
}

/* ---- Array: Unraid-style structure (square panels, red->orange gradient accents) ---- */
html:root { --ar-gradient: linear-gradient(90deg, #e22828, #ff8c2f); }
div.title {
  clip-path: none;
  outline: none;
  border-left: 3px solid #e22828;
  border-image: linear-gradient(180deg, #e22828, #ff8c2f) 1;
  background-image: linear-gradient(90deg, rgba(226, 40, 40, 0.16), rgba(24, 24, 26, 0) 45%);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 1.15rem;
  text-shadow: 0 0 10px rgba(226, 40, 40, 0.45);
}
.nav-tile { font-size: 1.15rem; letter-spacing: 0.1em; }
.nav-tile .nav-item.active a {
  box-shadow: none;
  background: var(--ar-gradient) left bottom / 100% 2px no-repeat;
}
.nav-tile .nav-item a:hover, .nav-tile .nav-item.active a { text-shadow: 0 0 10px rgba(255, 140, 47, 0.5); }
.tabs button[role="tab"][aria-selected="true"] { border-image: var(--ar-gradient) 1; }
.usage-bar > span:not(.orange):not(.red):not(.redbar):not(.orangebar) { background-image: var(--ar-gradient); }
input[type="button"]:hover, input[type="reset"]:hover, input[type="submit"]:hover,
button:not([role="tab"]):hover, a.button:hover { box-shadow: 0 0 12px rgba(226, 40, 40, 0.5); }
]]>
</INLINE>
</FILE>
<FILE Name="&emhttp;/parity.js">
<INLINE>
<![CDATA[
/* Unraid page background: a live disk array (Array theme).
 * The screen is an array of disks: vertical lanes of blocks, one lane per disk, every few lanes a parity disk.
 * - Writes: blocks heat up red -> orange and cool back down; some writes are sequential runs down a lane, and every
 *   write also touches the parity block on the same stripe (that is how parity works).
 * - Parity check: a red->orange scan band sweeps down the array, reading each stripe as it passes.
 * - Spin-down: idle disks occasionally dim (spun down) and later spin back up.
 * - The cursor warms the blocks under it.
 * Redraws at ~24 fps; requestAnimationFrame pauses it in hidden tabs; prefers-reduced-motion draws one still frame.
 */
(function () {
  'use strict'

  var CELL_W = 34 // block width (px)
  var CELL_H = 12 // block height (px)
  var GAP_X = 14 // gap between disk lanes
  var GAP_Y = 4 // gap between blocks
  var PARITY_EVERY = 7 // every Nth lane is a parity disk
  var FRAME_MS = 1000 / 24
  var COOL_PER_S = 0.55 // heat lost per second
  var WRITES_PER_S = 9 // random single-block writes
  var RUNS_PER_S = 0.7 // sequential write runs
  var SWEEP_S = 38 // seconds for the parity check band to cross the screen
  var HOVER_RADIUS = 130
  var BG = '#0b0b0c'

  // heat 0..1 -> idle charcoal -> brand red -> brand orange -> hot white-orange
  var STOPS = [
    [0.0, [24, 24, 26]],
    [0.35, [120, 22, 22]],
    [0.6, [226, 40, 40]],
    [0.85, [255, 140, 47]],
    [1.0, [255, 205, 150]],
  ]
  function heatColour(v, dim) {
    v = v < 0 ? 0 : v > 1 ? 1 : v
    var c = STOPS[STOPS.length - 1][1]
    for (var i = 1; i < STOPS.length; i++) {
      if (v <= STOPS[i][0]) {
        var a = STOPS[i - 1], b = STOPS[i], t = (v - a[0]) / (b[0] - a[0])
        c = [a[1][0] + (b[1][0] - a[1][0]) * t, a[1][1] + (b[1][1] - a[1][1]) * t, a[1][2] + (b[1][2] - a[1][2]) * t]
        break
      }
    }
    return 'rgb(' + ((c[0] * dim) | 0) + ',' + ((c[1] * dim) | 0) + ',' + ((c[2] * dim) | 0) + ')'
  }

  function DiskArray() {
    var self = this
    this.reducedMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)
    this.canvas = document.createElement('canvas')
    this.canvas.className = 'starfield-canvas'
    this.canvas.setAttribute('aria-hidden', 'true')
    document.body.insertBefore(this.canvas, document.body.firstChild)
    this.ctx = this.canvas.getContext('2d')
    if (!this.ctx) return
    this.acc = 0
    this.runs = []
    this.sweepY = Math.random()
    this.mx = this.my = -1e6
    this.resize()
    var timer
    window.addEventListener('resize', function () {
      clearTimeout(timer)
      timer = setTimeout(function () { self.resize() }, 150)
    })
    if (this.reducedMotion) return
    window.addEventListener('pointermove', function (e) {
      self.mx = e.clientX
      self.my = e.clientY
    })
    var leave = function () { self.mx = self.my = -1e6 }
    document.addEventListener('mouseleave', leave)
    window.addEventListener('blur', leave)
    window.addEventListener('pointerup', function (e) { if (e.pointerType !== 'mouse') leave() })
    this.last = performance.now()
    requestAnimationFrame(function loop(t) { self.tick(t); requestAnimationFrame(loop) })
  }

  DiskArray.prototype.resize = function () {
    var w = Math.max(1, window.innerWidth)
    var h = Math.max(1, window.innerHeight)
    this.w = w
    this.h = h
    this.dpr = Math.min(window.devicePixelRatio || 1, 2)
    this.canvas.width = Math.round(w * this.dpr)
    this.canvas.height = Math.round(h * this.dpr)
    this.lanes = Math.max(1, Math.floor((w + GAP_X) / (CELL_W + GAP_X)))
    this.rows = Math.max(1, Math.ceil(h / (CELL_H + GAP_Y)))
    this.x0 = Math.round((w - (this.lanes * (CELL_W + GAP_X) - GAP_X)) / 2)
    this.heat = new Float32Array(this.lanes * this.rows)
    this.hover = new Float32Array(this.lanes * this.rows)
    this.disks = []
    for (var l = 0; l < this.lanes; l++) {
      // seed a little residual heat so the first frame is not blank
      for (var r = 0; r < this.rows; r++) if (Math.random() < 0.05) this.heat[r * this.lanes + l] = Math.random() * 0.5
      this.disks.push({ parity: l % PARITY_EVERY === PARITY_EVERY - 1, spin: 1, target: 1, idle: Math.random() * 20 })
    }
    this.runs = []
    this.draw(performance.now())
  }

  DiskArray.prototype.parityLaneFor = function (lane) {
    var p = lane - (lane % PARITY_EVERY) + PARITY_EVERY - 1
    return p < this.lanes ? p : -1
  }

  DiskArray.prototype.write = function (lane, row, amount) {
    if (lane < 0 || row < 0 || lane >= this.lanes || row >= this.rows) return
    var d = this.disks[lane]
    d.target = 1 // writing spins the disk up
    d.idle = 0
    var i = row * this.lanes + lane
    this.heat[i] = Math.min(1, this.heat[i] + amount)
    if (!d.parity) {
      // the parity block on the same stripe is updated too
      var p = this.parityLaneFor(lane)
      if (p >= 0) {
        var j = row * this.lanes + p
        this.heat[j] = Math.min(1, this.heat[j] + amount * 0.8)
        this.disks[p].target = 1
        this.disks[p].idle = 0
      }
    }
  }

  DiskArray.prototype.randomDataLane = function () {
    for (var k = 0; k < 6; k++) {
      var l = (Math.random() * this.lanes) | 0
      if (!this.disks[l].parity) return l
    }
    return 0
  }

  DiskArray.prototype.tick = function (t) {
    var dt = Math.min(100, t - this.last)
    this.last = t
    this.acc += dt
    var cursorIn = this.mx > -1e5
    if (!(cursorIn || this.acc >= FRAME_MS)) return
    var s = this.acc / 1000
    this.acc = 0
    var n = this.heat.length
    // cool down
    var cool = COOL_PER_S * s
    for (var i = 0; i < n; i++) if (this.heat[i] > 0) this.heat[i] = Math.max(0, this.heat[i] - cool * (0.4 + this.heat[i]))
    // random writes
    var writes = WRITES_PER_S * s
    while (writes > 0) {
      if (Math.random() < writes) this.write(this.randomDataLane(), (Math.random() * this.rows) | 0, 0.55 + Math.random() * 0.45)
      writes -= 1
    }
    // sequential runs down a lane
    if (Math.random() < RUNS_PER_S * s) this.runs.push({ lane: this.randomDataLane(), row: (Math.random() * this.rows * 0.6) | 0, left: 6 + ((Math.random() * 18) | 0), acc: 0 })
    for (var k = this.runs.length - 1; k >= 0; k--) {
      var run = this.runs[k]
      run.acc += s
      while (run.acc > 0.045 && run.left > 0) {
        run.acc -= 0.045
        this.write(run.lane, run.row++, 0.9)
        run.left--
      }
      if (run.left <= 0 || run.row >= this.rows) this.runs.splice(k, 1)
    }
    // parity check sweep: reads (gently warms) every block on the stripes it crosses
    this.sweepY += s / SWEEP_S
    if (this.sweepY > 1.15) this.sweepY = -0.15
    var sweepRow = Math.floor((this.sweepY * this.h) / (CELL_H + GAP_Y))
    if (sweepRow >= 0 && sweepRow < this.rows)
      for (var l = 0; l < this.lanes; l++) {
        var idx = sweepRow * this.lanes + l
        var floor = this.disks[l].parity ? 0.62 : 0.4
        if (this.heat[idx] < floor) this.heat[idx] = floor
        this.disks[l].target = 1
      }
    // spin down idle disks, spin them up on demand
    for (var d = 0; d < this.lanes; d++) {
      var disk = this.disks[d]
      disk.idle += s
      if (disk.idle > 25 && Math.random() < 0.02 * s) disk.target = 0.35
      disk.spin += (disk.target - disk.spin) * Math.min(1, s * 1.5)
    }
    this.draw(t)
  }

  DiskArray.prototype.draw = function (t) {
    var ctx = this.ctx
    if (!ctx) return
    ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0)
    ctx.fillStyle = BG
    ctx.fillRect(0, 0, this.w, this.h)
    var mx = this.mx, my = this.my, hr = HOVER_RADIUS
    var smooth = Math.min(1, (FRAME_MS / 1000) * 6)
    for (var l = 0; l < this.lanes; l++) {
      var disk = this.disks[l]
      var x = this.x0 + l * (CELL_W + GAP_X)
      // lane rail: parity disks get a faint red rail
      ctx.fillStyle = disk.parity ? 'rgba(226,40,40,0.10)' : 'rgba(255,255,255,0.025)'
      ctx.fillRect(x - 3, 0, CELL_W + 6, this.h)
      for (var r = 0; r < this.rows; r++) {
        var i = r * this.lanes + l
        var y = r * (CELL_H + GAP_Y)
        var dx = x + CELL_W / 2 - mx, dy = y + CELL_H / 2 - my
        var d = Math.sqrt(dx * dx + dy * dy)
        var target = d < hr ? (1 - d / hr) * 0.55 : 0
        this.hover[i] += (target - this.hover[i]) * smooth
        var v = Math.max(this.heat[i], this.hover[i])
        ctx.fillStyle = heatColour(disk.parity ? v * 0.9 + 0.04 : v, 0.45 + 0.55 * disk.spin)
        ctx.fillRect(x, y, CELL_W, CELL_H)
      }
    }
    // parity check band
    var by = this.sweepY * this.h
    var band = ctx.createLinearGradient(0, by - 60, 0, by + 6)
    band.addColorStop(0, 'rgba(226,40,40,0)')
    band.addColorStop(0.85, 'rgba(226,40,40,0.10)')
    band.addColorStop(1, 'rgba(255,140,47,0.22)')
    ctx.fillStyle = band
    ctx.fillRect(0, by - 60, this.w, 66)
    var line = ctx.createLinearGradient(0, 0, this.w, 0)
    line.addColorStop(0, '#e22828')
    line.addColorStop(1, '#ff8c2f')
    ctx.fillStyle = line
    ctx.globalAlpha = 0.55
    ctx.fillRect(0, by + 5, this.w, 1.5)
    ctx.globalAlpha = 1
  }

  function start() {
    if (!document.body || document.querySelector('.starfield-canvas')) return
    new DiskArray()
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start)
  else start()
})()
]]>
</INLINE>
</FILE>
<FILE Run="/bin/bash">
<INLINE>
mkdir -p /usr/local/emhttp/plugins/parity/fonts
cp /boot/config/plugins/parity/fonts/*.woff2 /usr/local/emhttp/plugins/parity/fonts/ 2>/dev/null
chmod -R a+rX /usr/local/emhttp/plugins/parity
echo "parity: $(ls /usr/local/emhttp/plugins/parity/fonts | wc -l) fonts installed"
</INLINE>
</FILE>
<FILE Run="/bin/bash" Method="remove">
<INLINE>
# fonts on the flash are kept so a reinstall works
rm -rf /usr/local/emhttp/plugins/parity
echo "parity removed"
</INLINE>
</FILE>
</PLUGIN>
